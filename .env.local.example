# Client-side (Vite exposes anything prefixed VITE_ to the browser)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server-side ONLY. Never prefix with VITE_ — that would ship the key to the browser.
# Used exclusively by Supabase edge functions.
ANTHROPIC_API_KEY=

# Server-side ONLY. Used by supabase/seed/seed.ts (`pnpm seed`).
SUPABASE_SERVICE_ROLE_KEY=

# --- Local development escape hatch (optional) -------------------------------
# §2 of planning-overview.md specifies claude-sonnet-4-6, and that is what runs
# with none of these set. LLM_PROVIDER=deepseek swaps the provider for local
# runs when Anthropic credits aren't available; it changes nothing about the
# prompts, guardrails, trace shape, or cost accounting.
#
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# LLM_MODEL=            # optional; defaults to deepseek-v4-pro for that provider
